# Copy this file to .env. Never commit the resulting .env file.
# Generate a value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEMO_MODE=true
FLASK_DEBUG=true

# Emergency switch. Set false to stop new checkouts while allowing existing
# Square payment returns, gift-card payments, and /health to continue.
ORDERING_ENABLED=true
# Existing Square Online ordering page used when the emergency switch is off.
FALLBACK_ORDERING_URL=

# Added during Square integration. SQUARE_ACCESS_TOKEN is server-side only.
SQUARE_ENVIRONMENT=sandbox
SQUARE_CATALOG_ENABLED=false
SQUARE_API_VERSION=2026-07-15
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
# Public Web Payments SDK identifier. Setting it enables Square gift-card
# checkout; find the matching Sandbox or Production Application ID in Square.
SQUARE_APPLICATION_ID=
# Required when DEMO_MODE=false. Use the origin only, with no path.
PUBLIC_BASE_URL=

# Exact Square category names to publish, in display order. Additional categories
# are appended so existing pizza-only .env files automatically gain these sections.
SQUARE_ALLOWED_CATEGORY_NAMES=Seasonal Special Pies,Traditional Pies,Mari Pies
SQUARE_ADDITIONAL_CATEGORY_NAMES=Sides,Desserts,Salads,Drinks
# Only these categories count toward the per-slot and per-cart pizza limit.
SQUARE_PIZZA_CATEGORY_NAMES=Seasonal Special Pies,Traditional Pies,Mari Pies
SQUARE_EXCLUDED_MODIFIER_LIST_NAMES=Sides & Desserts,Drinks
SQUARE_CATALOG_CACHE_SECONDS=30
# Capacity thresholds. PIZZA_SLOT_CAPACITY is the default for schedule days that
# are not overridden. See README.md for weekday and one-date examples.
PIZZA_CART_LIMIT=3
PIZZA_SLOT_CAPACITY=3
CART_TOTAL_LIMIT=8
# Optional JSON. Each weekday or YYYY-MM-DD key replaces that day's defaults.
# Each window's end time is included. Leave empty to use the built-in schedule.
PICKUP_SCHEDULE=
